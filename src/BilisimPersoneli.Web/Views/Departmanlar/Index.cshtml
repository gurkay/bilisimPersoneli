@model PagedResult<DepartmanDto>
@{
    ViewData["Title"] = "Departmanlar";
    var isAdmin = User.IsInRole(AppRoles.Admin);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Departmanlar</h2>
    <a class="btn btn-primary" asp-action="Create">Yeni Departman</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Ad</th>
            <th>Açıklama</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Items)
    {
        <tr>
            <td>@item.Ad</td>
            <td>@item.Aciklama</td>
            <td class="text-end">
                <a asp-action="Details" asp-route-id="@item.Id">Detay</a> |
                <a asp-action="Edit" asp-route-id="@item.Id">Düzenle</a>
                @if (isAdmin)
                {
                    <text> | </text><a asp-action="Delete" asp-route-id="@item.Id">Sil</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

@await Html.PartialAsync("_Pagination", PaginationUiModel.From(Model))

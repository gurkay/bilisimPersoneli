@model IzinUpdateDto
@{
    ViewData["Title"] = "İzin Düzenle";
    var isPersonelOnly = User.IsInRole(AppRoles.Personel) && !User.IsInRole(AppRoles.Admin) && !User.IsInRole(AppRoles.Yonetici);
}

<h2>İzin Düzenle</h2>
<form asp-action="Edit" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    @if (isPersonelOnly)
    {
        <input type="hidden" asp-for="PersonelId" />
    }
    else
    {
        <div class="mb-3">
            <label asp-for="PersonelId" class="form-label"></label>
            <select asp-for="PersonelId" class="form-select" asp-items="ViewBag.Personeller"></select>
            <span asp-validation-for="PersonelId" class="text-danger"></span>
        </div>
    }
    <div class="mb-3">
        <label asp-for="BaslangicTarihi" class="form-label"></label>
        <input asp-for="BaslangicTarihi" class="form-control" type="date" />
        <span asp-validation-for="BaslangicTarihi" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="BitisTarihi" class="form-label"></label>
        <input asp-for="BitisTarihi" class="form-control" type="date" />
        <span asp-validation-for="BitisTarihi" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="IzinTuru" class="form-label"></label>
        <select asp-for="IzinTuru" class="form-select" asp-items="Html.GetEnumSelectList<IzinTuru>()"></select>
        <span asp-validation-for="IzinTuru" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Aciklama" class="form-label"></label>
        <textarea asp-for="Aciklama" class="form-control"></textarea>
        <span asp-validation-for="Aciklama" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-action="Index" class="btn btn-secondary">İptal</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }

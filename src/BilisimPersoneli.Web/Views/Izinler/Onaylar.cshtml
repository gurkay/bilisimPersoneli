@model PagedResult<IzinDto>
@{
    ViewData["Title"] = "İzin Onayları";
}

<h2>Bekleyen İzin Onayları</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Personel</th>
            <th>Başlangıç</th>
            <th>Bitiş</th>
            <th>Tür</th>
            <th>Açıklama</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Items)
    {
        <tr>
            <td>@item.PersonelAdSoyad</td>
            <td>@item.BaslangicTarihi.ToString("dd.MM.yyyy")</td>
            <td>@item.BitisTarihi.ToString("dd.MM.yyyy")</td>
            <td>@item.IzinTuru</td>
            <td>@item.Aciklama</td>
            <td class="text-end">
                <form asp-action="Onayla" asp-route-id="@item.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-success">Onayla</button>
                </form>
                <form asp-action="Reddet" asp-route-id="@item.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="onayNotu" value="Uygun bulunmadı" />
                    <button type="submit" class="btn btn-sm btn-danger">Reddet</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

@if (Model.TotalCount == 0)
{
    <p class="text-muted">Bekleyen izin talebi yok.</p>
}
else
{
    @await Html.PartialAsync("_Pagination", PaginationUiModel.From(Model))
}

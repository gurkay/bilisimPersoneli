@model PagedResult<IzinDto>
@{
    ViewData["Title"] = User.IsInRole(AppRoles.Personel)
        && !User.IsInRole(AppRoles.Admin)
        && !User.IsInRole(AppRoles.Yonetici)
        && !User.IsInRole(AppRoles.Isletmen)
        ? "İzinlerim"
        : "İzinler";
    var canManage = User.IsInRole(AppRoles.Admin);
    var showPersonelSearch = ViewBag.ShowPersonelSearch as bool? ?? true;
    var search = ViewBag.Search as string;
    var baslangic = ViewBag.Baslangic as string;
    var bitis = ViewBag.Bitis as string;
    var izinTuru = ViewBag.IzinTuru as IzinTuru?;
    var extra = new Dictionary<string, string?>
    {
        ["search"] = search,
        ["baslangic"] = baslangic,
        ["bitis"] = bitis,
        ["izinTuru"] = izinTuru?.ToString("d")
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@ViewData["Title"]</h2>
    <a class="btn btn-primary" asp-action="Create">Yeni İzin Talebi</a>
</div>

<form method="get" class="row g-2 align-items-end mb-3">
    <input type="hidden" name="page" value="1" />
    <input type="hidden" name="pageSize" value="@Model.PageSize" />
    @if (showPersonelSearch)
    {
        <div class="col-md-3">
            <label class="form-label" for="search">Personel Ad / Soyad</label>
            <input id="search" class="form-control" type="search" name="search" value="@search" placeholder="Ad veya soyad ara..." />
        </div>
    }
    <div class="col-md-2">
        <label class="form-label" for="baslangic">Başlangıç (≥)</label>
        <input id="baslangic" class="form-control" type="date" name="baslangic" value="@baslangic" />
    </div>
    <div class="col-md-2">
        <label class="form-label" for="bitis">Bitiş (≤)</label>
        <input id="bitis" class="form-control" type="date" name="bitis" value="@bitis" />
    </div>
    <div class="col-md-3">
        <label class="form-label" for="izinTuru">İzin Türü</label>
        <select id="izinTuru" class="form-select" name="izinTuru" asp-items="ViewBag.IzinTurleri">
            <option value="">Tüm türler</option>
        </select>
    </div>
    <div class="col-md-2 d-flex gap-2">
        <button class="btn btn-primary" type="submit">Filtrele</button>
        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-pageSize="@Model.PageSize">Temizle</a>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Personel</th>
            <th>Başlangıç</th>
            <th>Bitiş</th>
            <th>Tür</th>
            <th>Durum</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @if (Model.TotalCount == 0)
    {
        <tr>
            <td colspan="6" class="text-muted">Kayıt bulunamadı.</td>
        </tr>
    }
    else
    {
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.PersonelAdSoyad</td>
                <td>@item.BaslangicTarihi.ToString("dd.MM.yyyy")</td>
                <td>@item.BitisTarihi.ToString("dd.MM.yyyy")</td>
                <td>@item.IzinTuru</td>
                <td>@item.Durum</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@item.Id">Detay</a>
                    @if (item.Durum == IzinDurumu.Beklemede)
                    {
                        <text> | </text><a asp-action="Edit" asp-route-id="@item.Id">Düzenle</a>
                    }
                    @if (canManage)
                    {
                        <text> | </text><a asp-action="Delete" asp-route-id="@item.Id">Sil</a>
                    }
                </td>
            </tr>
        }
    }
    </tbody>
</table>

@await Html.PartialAsync("_Pagination", PaginationUiModel.From(Model, extraQuery: extra))

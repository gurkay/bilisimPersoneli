@model UserRolesUpdateDto
@{
    ViewData["Title"] = "Rol Atama";
    var allRoles = ViewBag.AllRoles as string[] ?? AppRoles.All;
    var selected = Model.SelectedRoles?.FirstOrDefault() ?? AppRoles.Personel;
}

<h2>Rol Atama</h2>
<p class="text-muted">Kullanıcıya tek bir birincil rol atanır.</p>

<form asp-action="Roles" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="UserId" />

    <div class="mb-3">
        @foreach (var role in allRoles)
        {
            var isChecked = string.Equals(selected, role, StringComparison.OrdinalIgnoreCase);
            <div class="form-check">
                <input class="form-check-input"
                       type="radio"
                       name="SelectedRoles"
                       value="@role"
                       id="role_@role"
                       @(isChecked ? "checked" : null) />
                <label class="form-check-label" for="role_@role">@role</label>
            </div>
        }
        <span asp-validation-for="SelectedRoles" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-action="Index" class="btn btn-link">Listeye dön</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model PagedResult<AuditLogDto>
@{
    ViewData["Title"] = "Audit Log";
    var extra = new Dictionary<string, string?>
    {
        ["entityName"] = ViewBag.EntityName as string,
        ["userName"] = ViewBag.UserName as string,
        ["from"] = ViewBag.From as string,
        ["to"] = ViewBag.To as string
    };
}

<h2>Audit Log</h2>

<form method="get" class="row g-2 mb-3">
    <input type="hidden" name="page" value="1" />
    <input type="hidden" name="pageSize" value="@Model.PageSize" />
    <div class="col-md-3">
        <input class="form-control" name="entityName" value="@ViewBag.EntityName" placeholder="Entity" />
    </div>
    <div class="col-md-3">
        <input class="form-control" name="userName" value="@ViewBag.UserName" placeholder="Kullanıcı" />
    </div>
    <div class="col-md-2">
        <input class="form-control" type="date" name="from" value="@ViewBag.From" />
    </div>
    <div class="col-md-2">
        <input class="form-control" type="date" name="to" value="@ViewBag.To" />
    </div>
    <div class="col-md-2">
        <button class="btn btn-primary w-100" type="submit">Filtrele</button>
    </div>
</form>

<table class="table table-sm table-striped">
    <thead>
        <tr>
            <th>Zaman</th>
            <th>Entity</th>
            <th>Id</th>
            <th>Aksiyon</th>
            <th>Kullanıcı</th>
            <th>Detay</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Items)
    {
        <tr>
            <td>@item.Timestamp.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
            <td>@item.EntityName</td>
            <td>@item.EntityId</td>
            <td>@item.Action</td>
            <td>@item.UserName</td>
            <td>@item.Details</td>
        </tr>
    }
    </tbody>
</table>

@await Html.PartialAsync("_Pagination", PaginationUiModel.From(Model, extraQuery: extra))

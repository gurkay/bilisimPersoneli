@model PersonelCreateDto

<div class="mb-3">
    <label asp-for="Ad" class="form-label"></label>
    <input asp-for="Ad" class="form-control" />
    <span asp-validation-for="Ad" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Soyad" class="form-label"></label>
    <input asp-for="Soyad" class="form-control" />
    <span asp-validation-for="Soyad" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Email" class="form-label"></label>
    <input asp-for="Email" class="form-control" />
    <span asp-validation-for="Email" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Telefon" class="form-label"></label>
    <input asp-for="Telefon" class="form-control" />
    <span asp-validation-for="Telefon" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Maas" class="form-label"></label>
    <input asp-for="Maas" class="form-control" />
    <span asp-validation-for="Maas" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="IseGirisTarihi" class="form-label"></label>
    <input asp-for="IseGirisTarihi" class="form-control" type="date" />
    <span asp-validation-for="IseGirisTarihi" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="DepartmanId" class="form-label"></label>
    <select asp-for="DepartmanId" class="form-select" asp-items="ViewBag.Departmanlar">
        <option value="">Seçiniz</option>
    </select>
    <span asp-validation-for="DepartmanId" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Sifre" class="form-label"></label>
    <input asp-for="Sifre" class="form-control" autocomplete="new-password" />
    <span asp-validation-for="Sifre" class="text-danger"></span>
    @if (ViewData["PasswordOptional"] as bool? == true)
    {
        <div class="form-text">Boş bırakırsanız mevcut şifre değişmez.</div>
    }
    else
    {
        <div class="form-text">Personel rolü ile giriş hesabı oluşturulur.</div>
    }
</div>
<div class="mb-3">
    <label asp-for="SifreTekrar" class="form-label"></label>
    <input asp-for="SifreTekrar" class="form-control" autocomplete="new-password" />
    <span asp-validation-for="SifreTekrar" class="text-danger"></span>
</div>
